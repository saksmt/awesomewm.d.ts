{
  "name": "awesomewm-example",
  "private": true,
  "version": "0.0.1",
  "description": "usage example of typescript type declarations for awesomewm (4.3) based on typescript-to-lua",
  "main": "src/rc.ts",
  "scripts": {
    "build": "tstl",
    "watch": "tstl --watch",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint '*/**/*.{js,jsx,ts,tsx}'",
    "lint-fix": "eslint '*/**/*.{js,jsx,ts,tsx}' --fix"
  },
  "files": [
    "src/**.ts"
  ],
  "author": "saksmt <smt@saksmt.dev>",
  "license": "MIT",
  "prettier": {
    "trailingComma": "all",
    "semi": true,
    "singleQuote": true,
    "printWidth": 100,
    "proseWrap": "always",
    "tabWidth": 2
  },
  "dependencies": {
    "awesomewm.4.3.d.ts": "file:../typing",
    "lua-types": "^2.13.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "9.26.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-to-lua": "^1.33.2"
  }
}
